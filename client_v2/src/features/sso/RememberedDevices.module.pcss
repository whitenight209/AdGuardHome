.section {
    margin-top: 24px;
    padding: 16px;
    border: 1px solid var(--default-secondary-button-stroke);
    border-radius: 8px;
}

.devices {
    padding: 0;
    list-style: none;
}

.device {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 0;
}

.details {
    min-width: 0;
    overflow-wrap: anywhere;
}
